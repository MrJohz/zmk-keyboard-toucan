#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define QWERTY 0
#define NAV    1
#define NUMPAD 2

#define COMBO_TIMEOUT 50

#define MY_GLB (LG(LC(SPACE)))

/ {

    combos {
        compatible = "zmk,combos";

        combo_lparen {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <3 4>;
            layers = <QWERTY>;
            bindings = <&kp LEFT_PARENTHESIS>;
        };
        combo_rparen {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <4 5>;
            layers = <QWERTY>;
            bindings = <&kp RIGHT_PARENTHESIS>;
        };
        combo_langle {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <15 16>;
            layers = <QWERTY>;
            bindings = <&kp LESS_THAN>;
        };
        combo_rangle {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <16 17>;
            layers = <QWERTY>;
            bindings = <&kp GREATER_THAN>;
        };
        combo_lbracket {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <26 27>;
            layers = <QWERTY>;
            bindings = <&kp LEFT_BRACKET>;
        };
        combo_rbracket {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <27 28>;
            layers = <QWERTY>;
            bindings = <&kp RIGHT_BRACKET>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            display-name = "QWERTY";
            bindings = <
                &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T        &kp Y     &kp U     &kp I     &kp O     &kp P    &trans
               &caps_word &kp A     &kp S     &kp D     &kp F     &kp G        &kp H     &kp J     &kp K     &kp L     &kp SEMI &kp SQT
               &kp MY_GLB &kp BSLH  &kp Z     &kp X     &kp C     &kp V        &kp B     &kp N     &kp M     &kp COMMA &kp DOT  &kp FSLH
                              &mt LALT TAB   &mt LCTRL BSPC   &kp LSHIFT       &lt NUMPAD RET   &lt NAV SPACE   &mt LGUI ESC
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
               &trans &trans &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans       &trans    &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans
                &trans    &trans   &kp C_PREV &kp C_PP &kp C_NEXT &trans       &trans    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans
                &trans    &trans    &trans    &trans    &trans    &trans       &trans    &mkp MB4  &trans    &trans    &mkp MB5  &trans
                                              &trans    &trans    &trans       &trans    &trans    &trans
            >;
        };

        sym {
            display-name = "NUMPAD";
            bindings = <
                &trans    &trans    &kp F7    &kp F8    &kp F9    &kp F12      &kp KP_EQUAL &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MULTIPLY &trans
                &trans    &trans    &kp F4    &kp F5    &kp F6    &kp F11      &kp KP_PLUS  &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_SLASH &trans
                &trans    &trans    &kp F1    &kp F2    &kp F3    &kp F10      &kp KP_MINUS &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_DOT   &kp KP_N0
                                              &trans    &trans    &trans       &trans    &trans    &trans
            >;
        };
    };
};
