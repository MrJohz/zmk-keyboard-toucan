#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define QWERTY  0
#define NAV     1
#define NUMPAD  2
#define TAIPO   3
#define STENO   4
#define CONTROL 5


// CONFIG
#define COMBO_TIMEOUT 70
#define TAIPO_COMBO_LAYER TAIPO
#define STICKY_TIMEOUT 500

// LEFT SIDE
#define TLI  4 // TOP
#define TLM  3 // TOP
#define TLR  2 // TOP
#define TLP  1 // TOP
#define BLI 16 // BOTTOM
#define BLM 15 // BOTTOM
#define BLR 14 // BOTTOM
#define BLP 13 // BOTTOM
#define LOT 38 // O-THUMB
#define LIT 37 // I-THUMB

// RIGHT SIDE
#define TRI  7 // TOP
#define TRM  8 // TOP
#define TRR  9 // TOP
#define TRP 10 // TOP
#define BRI 19 // BOTTOM
#define BRM 20 // BOTTOM
#define BRR 21 // BOTTOM
#define BRP 22 // BOTTOM
#define ROT 39 // O-THUMB
#define RIT 40 // I-THUMB

#define MY_GLB (LG(LC(SPACE)))

&mt {
    quick-tap-ms = <150>;
};

/ {

    combos {
        compatible = "zmk,combos";

        #include "taipo.dtsi"

        combo_control_layer {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <39 40>;
            // Not active on STENO: positions 39+40 are the E+U steno chord there.
            // CONTROL is reached from STENO via the top-corner &mo CONTROL keys instead.
            layers = <QWERTY NAV NUMPAD TAIPO>;
            bindings = <&mo CONTROL>;
        };

        combo_lparen {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <2 14>;
            layers = <QWERTY>;
            bindings = <&kp LEFT_PARENTHESIS>;
        };
        combo_rparen {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <3 15>;
            layers = <QWERTY>;
            bindings = <&kp RIGHT_PARENTHESIS>;
        };
        combo_langle {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <4 16>;
            layers = <QWERTY>;
            bindings = <&kp LESS_THAN>;
        };
        combo_rangle {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <5 17>;
            layers = <QWERTY>;
            bindings = <&kp GREATER_THAN>;
        };
        combo_lbracket {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <14 26>;
            layers = <QWERTY>;
            bindings = <&kp LEFT_BRACKET>;
        };
        combo_rbracket {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <15 27>;
            layers = <QWERTY>;
            bindings = <&kp RIGHT_BRACKET>;
        };
        combo_excl {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <1 13>;
            layers = <QWERTY>;
            bindings = <&kp EXCLAMATION>;
        };
        combo_ques {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <13 25>;
            layers = <QWERTY>;
            bindings = <&kp QUESTION>;
        };
        combo_grave {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <16 28>;
            layers = <QWERTY>;
            bindings = <&kp GRAVE>;
        };
        combo_hat {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <17 29>;
            layers = <QWERTY>;
            bindings = <&kp CARET>;
        };
        combo_hash {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <6 18>;
            layers = <QWERTY>;
            bindings = <&kp NUHS>;
        };
        combo_dollar {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <18 30>;
            layers = <QWERTY>;
            bindings = <&kp DOLLAR>;
        };
        combo_ampersand {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <7 19>;
            layers = <QWERTY>;
            bindings = <&kp AMPERSAND>;
        };
        combo_asterisk {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <19 31>;
            layers = <QWERTY>;
            bindings = <&kp ASTERISK>;
        };
        combo_quote {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <8 20>;
            layers = <QWERTY>;
            bindings = <&kp LS(N2)>;
        };
        combo_percent {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <20 32>;
            layers = <QWERTY>;
            bindings = <&kp PERCENT>;
        };
        combo_tilde {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <9 21>;
            layers = <QWERTY>;
            bindings = <&kp TILDE2>;
        };
        combo_at {
            timeout-ms = <COMBO_TIMEOUT>;
            key-positions = <21 33>;
            layers = <QWERTY>;
            bindings = <&kp LS(SINGLE_QUOTE)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            display-name = "QWE";
            bindings = <
            &mt LCTRL TAB &kp Q     &kp W     &kp E     &kp R     &kp T        &kp Y     &kp U     &kp I     &kp O     &kp P    &kp MINUS
               &caps_word &kp A     &kp S     &kp D     &kp F     &kp G        &kp H     &kp J     &kp K     &kp L     &kp SEMI &kp SQT
               &kp MY_GLB &kp NUBS  &kp Z     &kp X     &kp C     &kp V        &kp B     &kp N     &kp M     &kp COMMA &kp DOT  &kp FSLH
                              &mt LALT TAB   &mt LCTRL BSPC   &kp LSHIFT       &lt NUMPAD RET   &lt NAV SPACE   &mt LGUI ESC
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
               &trans &trans &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans       &trans    &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans
                &trans    &trans   &kp C_PREV &kp C_PP &kp C_NEXT &trans       &trans    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans
                &trans    &trans    &trans    &trans    &trans    &trans       &trans    &mkp MB4  &trans    &trans    &mkp MB5  &trans
                                              &trans    &trans    &trans       &trans    &trans    &trans
            >;
        };

        sym {
            display-name = "NUM";
            bindings = <
                &trans    &trans    &kp F7    &kp F8    &kp F9    &kp F12      &kp EQUAL &kp N7    &kp N8    &kp N9    &kp STAR  &trans
                &trans    &trans    &kp F4    &kp F5    &kp F6    &kp F11      &kp PLUS  &kp N4    &kp N5    &kp N6    &kp SLASH &trans
                &trans    &trans    &kp F1    &kp F2    &kp F3    &kp F10      &kp MINUS &kp N1    &kp N2    &kp N3    &kp DOT   &kp N0
                                              &trans    &trans    &trans       &trans    &trans    &trans
            >;
        };

        taipo {
            display-name = "TAI";
            bindings = <
                &none      &none      &none      &none      &none      &none        &none      &none      &none      &none      &none      &none
                &none      &none      &none      &none      &none      &none        &none      &none      &none      &none      &none      &none
                &none      &none      &none      &none      &none      &none        &none      &none      &none      &none      &none      &none
                                                 &none      &none      &none        &none      &none      &none
            >;
        };

        steno {
            display-name = "STN";
            bindings = <
                &mo CONTROL &none      &none      &none      &none      &none        &none      &none      &none      &none      &none      &mo CONTROL
                &none      &none      &none      &none      &none      &none        &none      &none      &none      &none      &none      &none
                &none      &none      &none      &none      &none      &none        &none      &none      &none      &none      &none      &none
                                                 &none      &none      &none        &none      &none      &none
            >;
        };

        control {
            display-name = "CON";
            bindings = <
                &none      &none      &none      &none      &none      &none        &to QWERTY &to TAIPO  &to STENO  &none      &none      &none
                &none      &none      &none      &none      &none      &none        &bt BT_NXT &bt BT_PRV &bt BT_CLR &none      &none      &none
                &none      &none      &none      &none      &none      &none        &none      &none      &none      &none      &none      &none
                                                 &none      &none      &none        &none      &none      &none 
            >;
        };
    };
};
